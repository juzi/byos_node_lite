<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>CrowPanel</title>
</head>
<body>
<style>
    /* 1024x600, the CrowPanel Advance 9". Everything here is self-contained on purpose: the render
       container has no network, so an external stylesheet or webfont would simply not arrive.
       Dark background because this thing sits in a room rather than on a desk, and a white panel
       at 400 cd/m2 is a lamp. */

    html, body {
        margin: 0;
        padding: 0;
        width: 1024px;
        height: 600px;
        overflow: hidden;
    }

    div.display {
        width: 1024px;
        height: 600px;
        overflow: hidden;
        background: #0d0f12;
        color: #eceff1;
        font-family: "Liberation Sans", "LiberationSans", Arial, "DejaVu Sans", sans-serif;
        display: grid;
        grid-template-rows: 356px 244px;
        position: relative;
    }

    /* The accent every glucose-derived element takes its colour from, so the band is expressed once
       rather than repeated on the number, the arrow and the delta. */
    div.band-inRange    { --accent: #4caf50; }
    div.band-low        { --accent: #ef5350; }
    div.band-urgentLow  { --accent: #ff1744; }
    div.band-high       { --accent: #ffa726; }
    div.band-urgentHigh { --accent: #ff1744; }
    div.band-unknown    { --accent: #78909c; }

    /* A stale reading loses its colour. Green is a claim about right now, and a number from forty
       minutes ago is not entitled to make it -- the value stays visible, the reassurance does not. */
    div.display.is-stale { --accent: #78909c; }

    /* The widest case this has to survive is a three-digit reading with a double arrow and a
       two-digit delta. Sized for that rather than for the common case, and clipped rather than
       allowed to push the cards below off the right edge. */
    div.reading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 22px;
        padding: 0 32px;
        min-width: 0;
        overflow: hidden;
    }

    /* Amber rather than the red used for a wearable that is due: this says "possibly out of date",
       not "act now", and a red triangle beside a glucose number reads as the latter. */
    svg.age-warn {
        width: 100px;
        height: 100px;
        flex: none;
        fill: #ffb300;
    }

    div.sugar {
        font-size: 212px;
        font-weight: bold;
        line-height: 1;
        color: var(--accent);
        letter-spacing: -6px;
    }

    /* The arrow is drawn rather than set as a glyph: no font in the render container is guaranteed
       to carry the double arrows, and a missing glyph on a glucose display is a silent failure.
       The viewBox is square and larger than the arrow so a 45-degree rotation about the centre
       cannot clip the corners; the empty margin also separates the two arrows of a double. */
    div.arrow {
        display: flex;
        align-items: center;
        gap: 0;
    }

    svg.arrow-glyph {
        width: 132px;
        height: 132px;
        flex: none;
    }

    svg.arrow-glyph path {
        fill: var(--accent);
    }

    div.arrow-unknown {
        font-size: 104px;
        font-weight: bold;
        color: var(--accent);
    }

    div.delta {
        font-size: 76px;
        font-weight: bold;
        color: #b0bec5;
        white-space: nowrap;
    }

    /* Only rendered when the reading has stopped arriving. A panel quietly showing a number from
       forty minutes ago is the one failure mode worth shouting about. */
    div.stale {
        position: absolute;
        top: 22px;
        right: 28px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #ff1744;
        color: #fff;
        font-size: 30px;
        font-weight: bold;
        letter-spacing: 2px;
        padding: 10px 22px;
        border-radius: 10px;
    }

    div.stale svg {
        width: 34px;
        height: 34px;
        fill: #fff;
    }

    div.wearables {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 26px;
        padding: 0 32px 24px 32px;
        min-width: 0;
    }

    div.card {
        background: #171b20;
        border-radius: 22px;
        border: 3px solid #252b32;
        display: grid;
        /* The label and the value are different kinds of thing, and butted together they read as
           one block. The gap is what makes "SENSOR LEFT" a heading rather than a prefix. */
        grid-template-rows: 50px 1fr;
        row-gap: 20px;
        align-items: center;
        padding: 0 24px;
        min-width: 0;
        overflow: hidden;
    }

    /* A wearable inside its warning window turns the whole card red rather than adding a small
       badge to it: the point is to be readable from across the room. */
    div.card.expiring {
        background: #2a1416;
        border-color: #ff1744;
    }

    div.card svg.icon {
        height: 34px;
        flex: none;
        fill: #90a4ae;
    }

    /* Widths given explicitly rather than left to width:auto -- the two viewBoxes have different
       aspect ratios, and auto resolution from a viewBox is not reliable across Chrome versions. */
    div.card svg.icon.sensor {
        width: 47px;
    }

    div.card svg.icon.pod {
        width: 72px;
    }

    div.card.expiring svg.icon {
        fill: #ff8a80;
    }

    /* "LEFT" is load-bearing: without it a bare duration under "POD" is indistinguishable from the
       age the TRMNL screen shows, and 9 hours remaining reads as 9 hours old -- opposite meanings
       at the one moment the card matters. */
    div.card-label {
        align-self: end;
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 32px;
        font-weight: bold;
        letter-spacing: 4px;
        white-space: nowrap;
        color: #78909c;
    }

    div.card.expiring div.card-label {
        color: #ff8a80;
    }

    /* The icon sits up with the label, so the whole value row belongs to the number and the
       warning triangle -- which can then be read from across the room instead of squinted at,
       and still leaves the widest duration string clear of the border. */
    div.card-value {
        align-self: start;
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 84px;
        font-weight: bold;
        line-height: 1;
        color: #eceff1;
        white-space: nowrap;
    }

    div.card.expiring div.card-value {
        color: #ff5252;
    }

    div.card-value svg.warn {
        width: 82px;
        height: 82px;
        flex: none;
        fill: #ff1744;
    }

    /* Kept in the layout but invisible when there is nothing to warn about, so the number sits in
       the same place whether or not the warning is showing. Without this it jumps sideways the
       moment a wearable enters its window, which reads as the display glitching. */
    div.card-value svg.warn.placeholder {
        visibility: hidden;
    }

    /* Only the POD card has a second line -- the reservoir reading has no sensor equivalent. A
       wrapper around the existing card-value rather than a change to it, so SENSOR's markup and
       styling are untouched. */
    div.card-value-stack {
        align-self: start;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    div.card-value-stack div.card-value {
        align-self: auto;
    }

    /* Deliberately smaller than card-label, not just quieter in colour: this is a second reading on
       the same card, not a second heading, and it should not compete with "POD LEFT" above it. */
    div.card-insulin {
        font-size: 34px;
        font-weight: bold;
        color: #78909c;
        white-space: nowrap;
    }

    div.card.expiring div.card-insulin {
        color: #ff8a80;
    }

    /* Replaces the whole screen when the server could not produce a reading, so the panel never
       shows a stale number dressed up as a current one. */
    div.error {
        grid-row: 1 / span 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 28px;
        padding: 0 60px;
        text-align: center;
    }

    div.error svg {
        width: 130px;
        height: 130px;
        fill: #ff1744;
    }

    div.error-title {
        font-size: 64px;
        font-weight: bold;
        color: #ff5252;
    }

    div.error-detail {
        font-size: 36px;
        color: #b0bec5;
        word-break: break-word;
    }
</style>

{% comment %}
    One arrow path, pointing up, rotated per trend. Rotating a single shape keeps the seven
    directions consistent with each other, which drawing seven paths by hand would not.
{% endcomment %}
{% assign rotation = 0 %}
{% case trend %}
    {% when 'FortyFiveUp' %}{% assign rotation = 45 %}
    {% when 'Flat' %}{% assign rotation = 90 %}
    {% when 'FortyFiveDown' %}{% assign rotation = 135 %}
    {% when 'SingleDown' %}{% assign rotation = 180 %}
    {% when 'DoubleDown' %}{% assign rotation = 180 %}
{% endcase %}

<div class="display band-{{ band }}{% if stale %} is-stale{% endif %}">
    {% if error != '' %}
        <div class="error">
            <svg viewBox="0 0 24 24">
                <path d="M12,1.6 L23.6,22 L0.4,22 Z"/>
                <rect x="10.6" y="8.2" width="2.8" height="7.6" fill="#0d0f12"/>
                <rect x="10.6" y="17.2" width="2.8" height="2.8" fill="#0d0f12"/>
            </svg>
            <div class="error-title">No reading</div>
            <div class="error-detail">{{ error }}</div>
        </div>
    {% else %}
        {% if stale %}
            <div class="stale">
                <svg viewBox="0 0 24 24">
                    <path d="M12,1.6 L23.6,22 L0.4,22 Z"/>
                    <rect x="10.6" y="8.2" width="2.8" height="7.6" fill="#ff1744"/>
                    <rect x="10.6" y="17.2" width="2.8" height="2.8" fill="#ff1744"/>
                </svg>
                STALE
            </div>
        {% endif %}

        <div class="reading">
            {% if ageWarning %}
                <svg class="age-warn" viewBox="0 0 24 24" aria-label="reading is not current">
                    <path d="M12,1.6 L23.6,22 L0.4,22 Z"/>
                    <rect x="10.6" y="8.2" width="2.8" height="7.6" fill="#0d0f12"/>
                    <rect x="10.6" y="17.2" width="2.8" height="2.8" fill="#0d0f12"/>
                </svg>
            {% endif %}
            <div class="sugar">{{ sugar }}</div>
            <div class="arrow">
                {% if trend == 'None' %}
                    <div class="arrow-unknown">?</div>
                {% else %}
                    <svg class="arrow-glyph" viewBox="0 0 160 160">
                        <path d="M80,18 L116,66 L94,66 L94,142 L66,142 L66,66 L44,66 Z"
                              transform="rotate({{ rotation }} 80 80)"/>
                    </svg>
                    {% if trend == 'DoubleUp' or trend == 'DoubleDown' %}
                        <svg class="arrow-glyph" viewBox="0 0 160 160">
                            <path d="M80,18 L116,66 L94,66 L94,142 L66,142 L66,66 L44,66 Z"
                                  transform="rotate({{ rotation }} 80 80)"/>
                        </svg>
                    {% endif %}
                {% endif %}
            </div>
            <div class="delta">{{ sign }}{{ delta }}</div>
        </div>

        <div class="wearables">
            {% comment %} Sensor icon: ic_cp_age_sensor from AndroidAPS, as in the TRMNL template. {% endcomment %}
            <div class="card{% if sensorExpiring %} expiring{% endif %}">
                <div class="card-label">
                    <svg class="icon sensor" viewBox="1.2 4.6 20 14.4" aria-label="sensor">
                        <path d="M13.568,13.328c0.673,0 1.219,-0.546 1.219,-1.219s-0.546,-1.219 -1.219,-1.219c-0.493,0 -0.913,0.296 -1.105,0.718h-1.603L9.464,8.126c-0.078,-0.195 -0.246,-0.309 -0.48,-0.314c-0.21,0.006 -0.394,0.144 -0.459,0.343l-2.16,6.53l-1.131,-2.751c-0.077,-0.188 -0.26,-0.31 -0.463,-0.31h-2c-0.276,0 -0.5,0.224 -0.5,0.5s0.224,0.5 0.5,0.5h1.665l1.518,3.69c0.078,0.188 0.261,0.31 0.463,0.31c0.006,0 0.012,0 0.018,0c0.209,-0.008 0.392,-0.145 0.458,-0.343L9.045,9.77l1.012,2.525c0.076,0.19 0.26,0.314 0.464,0.314h1.941C12.654,13.031 13.074,13.328 13.568,13.328z"/>
                        <path d="M13.567,15.055c-0.276,0 -0.5,0.224 -0.5,0.5s0.224,0.5 0.5,0.5c2.176,0 3.945,-1.77 3.945,-3.945s-1.77,-3.946 -3.945,-3.946c-0.276,0 -0.5,0.224 -0.5,0.5s0.224,0.5 0.5,0.5c1.624,0 2.945,1.321 2.945,2.945S15.191,15.055 13.567,15.055z"/>
                        <path d="M13.567,5.14c-0.276,0 -0.5,0.224 -0.5,0.5s0.224,0.5 0.5,0.5c3.291,0 5.969,2.677 5.969,5.968s-2.678,5.969 -5.969,5.969c-0.276,0 -0.5,0.224 -0.5,0.5s0.224,0.5 0.5,0.5c3.843,0 6.969,-3.126 6.969,-6.969S17.41,5.14 13.567,5.14z"/>
                    </svg>
                    SENSOR LEFT
                </div>
                <div class="card-value">
                    <svg class="warn{% unless sensorExpiring %} placeholder{% endunless %}" viewBox="0 0 24 24" aria-label="expiring">
                        <path d="M12,1.6 L23.6,22 L0.4,22 Z"/>
                        <rect x="10.6" y="8.2" width="2.8" height="7.6" fill="#2a1416"/>
                        <rect x="10.6" y="17.2" width="2.8" height="2.8" fill="#2a1416"/>
                    </svg>
                    {{ sensorRemaining }}
                </div>
            </div>

            {% comment %} Pod icon: ic_cp_age_cannula from AndroidAPS, as in the TRMNL template. {% endcomment %}
            {% assign podWarning = podExpiring or podInsulinLow %}
            <div class="card{% if podWarning %} expiring{% endif %}">
                <div class="card-label">
                    <svg class="icon pod" viewBox="1.6 8.6 20.4 9.6" aria-label="pod">
                        <path d="M20.951,10.458h-1.99c-0.054,-0.733 -0.659,-1.313 -1.406,-1.313h-2.354c-0.747,0 -1.352,0.58 -1.406,1.313h-1.99c-0.388,0 -0.696,0.27 -0.771,0.622c-1.32,-0.021 -2.226,-0.555 -2.936,-0.999c-0.7,-0.437 -1.304,-0.814 -2.005,-0.434c-1.202,0.654 -0.843,2.024 -0.554,3.126c0.192,0.731 0.39,1.489 0.098,1.836c-0.603,0.718 -2.212,0.276 -2.781,0.045c-0.143,-0.057 -0.31,0.011 -0.369,0.156c-0.059,0.146 0.011,0.311 0.156,0.369c0.061,0.024 0.971,0.388 1.893,0.388c0.574,0 1.153,-0.142 1.534,-0.593c0.482,-0.571 0.256,-1.433 0.017,-2.345c-0.323,-1.234 -0.479,-2.074 0.276,-2.485c0.392,-0.213 0.762,-0.003 1.434,0.417c0.755,0.471 1.766,1.123 3.359,1.096C11.301,11.859 11.531,12 11.806,12h4.406v5.771l0.333,-0.854V12h4.406c0.443,0 0.802,-0.345 0.802,-0.771S21.394,10.458 20.951,10.458z"/>
                    </svg>
                    POD LEFT
                </div>
                <div class="card-value-stack">
                    <div class="card-value">
                        <svg class="warn{% unless podWarning %} placeholder{% endunless %}" viewBox="0 0 24 24" aria-label="expiring">
                            <path d="M12,1.6 L23.6,22 L0.4,22 Z"/>
                            <rect x="10.6" y="8.2" width="2.8" height="7.6" fill="#2a1416"/>
                            <rect x="10.6" y="17.2" width="2.8" height="2.8" fill="#2a1416"/>
                        </svg>
                        {{ podRemaining }}
                    </div>
                    <div class="card-insulin">{{ podInsulin }}</div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
</body>
</html>
